# ─── Base de données (Neon ou Supabase, offre gratuite) ─────────────────────
# Neon : URL « pooled » pour l'app, URL directe pour les migrations
# Supabase : Transaction pooler (port 6543) + Session/Direct (port 5432)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ─── Authentification (NextAuth / Auth.js v5) ──────────────────────────────
# Générer avec : npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET=""

# Compte admin créé par `npm run db:seed` (relancer le seed pour changer le mot de passe)
ADMIN_EMAIL="miora@exemple.com"
ADMIN_PASSWORD="un-mot-de-passe-solide"
ADMIN_NAME="Miora Dinasoa"

# ─── Infos publiques du site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://miora-dinasoa.vercel.app"
NEXT_PUBLIC_CONTACT_EMAIL="contact@exemple.com"
# Format international sans « + » ni espaces (ex. Madagascar : 261341234567)
NEXT_PUBLIC_WHATSAPP_NUMBER="261340000000"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/miora-dinasoa"

# ─── Emails / notifications ────────────────────────────────────────────────
# smtp | resend | brevo   (vide = emails affichés dans la console)
EMAIL_PROVIDER=""
# Destinataire des notifications de nouvelles demandes
ADMIN_NOTIFICATION_EMAIL="miora@exemple.com"
# Expéditeur (doit être autorisé chez le fournisseur choisi)
MAIL_FROM="Miora Dinasoa <miora@exemple.com>"

# Option 1 — SMTP Gmail (mot de passe d'application) : smtp.gmail.com / 465
#          ou SMTP Brevo : smtp-relay.brevo.com / 587
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""

# Option 2 — Resend (https://resend.com)
RESEND_API_KEY=""

# Option 3 — API Brevo (https://brevo.com)
BREVO_API_KEY=""
